# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Archive-capable RPC endpoint (e.g. Alchemy or Infura mainnet URL) —
# used by `latentedge ingest` for block ranges reaching back further than
# a few hours. Free public endpoints (the CLI's built-in default) gate
# deep history behind a paid token.
LATENTEDGE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key-here

# How many most-recent days of blocks `latentedge ingest` pulls when
# --from-block/--to-block are omitted. A full year of history for real
# training; drop this to something small (e.g. 1) for a quick test run
# before committing to a long pull — see LATENTEDGE_INGEST_DAYS in the
# CLI's --help for details.
LATENTEDGE_INGEST_DAYS=365

# Every other `ingest`/`train`/`backtest` flag also has an env var
# fallback (see `latentedge <command> --help` for the exact name of
# each), so a run can be fully configured here and invoked with no
# flags at all. Set to the CLI's own built-in defaults below — edit any
# of these, or pass the matching flag to override just that run.
LATENTEDGE_INGEST_OUT=data/swaps.parquet
LATENTEDGE_CHUNK_SIZE=10
LATENTEDGE_MAX_WORKERS=4
LATENTEDGE_FLUSH_EVERY_N_CHUNKS=50
LATENTEDGE_MAX_RETRIES=5
LATENTEDGE_RETRY_BACKOFF_SECONDS=2.0
LATENTEDGE_CONCURRENCY_COOLDOWN_SECONDS=2.0
LATENTEDGE_MAX_RATE_LIMIT_BACKOFF_SECONDS=120.0

# Request pacing against the provider. Auto-throttle (default) starts at
# LATENTEDGE_INGEST_MAX_RPS, steps down on 429s and probes upward. Set it
# to false to pin the rate instead — then LATENTEDGE_INGEST_FIXED_RPS is
# required (e.g. 8.6) and the rate never changes; 429s still retry/cool down.
LATENTEDGE_INGEST_AUTO_THROTTLE=true
LATENTEDGE_INGEST_MAX_RPS=5.0
# LATENTEDGE_INGEST_FIXED_RPS=8.6

# Start training immediately once `ingest` finishes, instead of pausing
# for a [T]/[Q] prompt (TTY) or just exiting (non-TTY) — useful for an
# unattended long ingest run. false keeps the pause-and-review default.
LATENTEDGE_TRAIN_AFTER_INGEST=false

LATENTEDGE_TRAIN_SWAPS=data/swaps.parquet
LATENTEDGE_TRAIN_OUT=data/model.safetensors
LATENTEDGE_TRAIN_EPOCHS=100

# Start the backtest immediately once training finishes (after `train`, or
# the training an ingest chains into), instead of pausing for a [B]/[Q]
# prompt. Uses the LATENTEDGE_BACKTEST_* settings below.
LATENTEDGE_BACKTEST_AFTER_TRAIN=false

LATENTEDGE_BACKTEST_SWAPS=data/swaps.parquet
LATENTEDGE_BACKTEST_MODEL=data/model.safetensors
# Backtest sizing and risk limits. The backtest replays only the model's
# untouched test window and writes <model>.backtest.json.
LATENTEDGE_BACKTEST_INITIAL_EQUITY=10000
LATENTEDGE_BACKTEST_MAX_POSITION_FRACTION=0.10
LATENTEDGE_BACKTEST_DAILY_LOSS_LIMIT_FRACTION=0.02
LATENTEDGE_BACKTEST_FULL_SIZE_RETURN=0.002

# --from-block/--to-block have no sensible default (setting either here
# would lock every run to a fixed range instead of the normal
# most-recent-N-days window) — left unset on purpose. Uncomment only if
# you specifically want every run pinned to the same explicit range:
# LATENTEDGE_FROM_BLOCK=
# LATENTEDGE_TO_BLOCK=

# `latentedge sweep`: replays the model under a grid of trading rules on the
# validation and test windows, next to always-trade and oracle references,
# and saves every result (never overwriting earlier sweeps) for comparison.
# Equity and risk limits come from the LATENTEDGE_BACKTEST_* settings above.
LATENTEDGE_SWEEP_SWAPS=data/swaps.parquet
LATENTEDGE_SWEEP_MODEL=data/model.safetensors
LATENTEDGE_SWEEP_OUT_DIR=data/sweeps
# Minimum predicted net return a trade must clear (0.0013 is about the
# average round-trip cost), and the predicted return that sizes a position
# at the full maximum.
LATENTEDGE_SWEEP_MIN_EDGES=0,0.0013
LATENTEDGE_SWEEP_FULL_SIZE_RETURNS=0.002
# Rank rule: trade only this share of bars, the ones the model ranks
# highest, at full size. Works even when no prediction is above zero.
# The cutoff is set on the validation window.
LATENTEDGE_SWEEP_TOP_FRACTIONS=0.01,0.05,0.10,0.25,0.50,1.0
# Shuffled control: for each seed, the rank rules above are also run on the
# model's predictions shuffled among the bars (same values, no information).
# A real signal must beat these. Empty turns the control off.
LATENTEDGE_SWEEP_SHUFFLE_SEEDS=0,1,2

# Training experiments (only `train`, or the training an ingest chains into,
# reads these; a backtest or sweep reuses what the model was trained with,
# so use a different LATENTEDGE_TRAIN_OUT for each experiment).
# Drop features to test whether the model predicts trading cost, not direction:
# LATENTEDGE_TRAIN_EXCLUDE_FEATURES=base_fee_gwei,volatility
# Label horizon in minutes (default 30) and take-profit/stop-loss band in
# standard deviations of the 1-bar return (default 2). Widen the band with
# the horizon, or a narrow band is hit within minutes anyway: 240 minutes
# with about 6 is comparable to today's 30 minutes with 2.
# LATENTEDGE_LABEL_HORIZON_MINUTES=240
# LATENTEDGE_LABEL_BARRIER_STDS=6

# Run the sweep right after training (before any chained backtest), in
# `train` and in the training an ingest chains into. The sweep replays the
# model under many trading rules on validate and test, with shuffled and
# oracle references, and saves the result under LATENTEDGE_SWEEP_OUT_DIR.
LATENTEDGE_SWEEP_AFTER_TRAIN=true

# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Archive-capable RPC endpoint (e.g. Alchemy or Infura mainnet URL) —
# used by `latentedge ingest` for block ranges reaching back further than
# a few hours. Free public endpoints (the CLI's built-in default) gate
# deep history behind a paid token.
LATENTEDGE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key-here

# How many most-recent days of blocks `latentedge ingest` pulls when
# --from-block/--to-block are omitted. A full year of history for real
# training; drop this to something small (e.g. 1) for a quick test run
# before committing to a long pull — see LATENTEDGE_INGEST_DAYS in the
# CLI's --help for details.
LATENTEDGE_INGEST_DAYS=365

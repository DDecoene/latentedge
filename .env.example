# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Archive-capable RPC endpoint (e.g. Alchemy or Infura mainnet URL) —
# used by `latentedge ingest` for block ranges reaching back further than
# a few hours. Free public endpoints (the CLI's built-in default) gate
# deep history behind a paid token.
LATENTEDGE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key-here

# How many most-recent days of blocks `latentedge ingest` pulls when
# --from-block/--to-block are omitted. A full year of history for real
# training; drop this to something small (e.g. 1) for a quick test run
# before committing to a long pull — see LATENTEDGE_INGEST_DAYS in the
# CLI's --help for details.
LATENTEDGE_INGEST_DAYS=365

# Every other `ingest`/`train`/`backtest` flag also has an env var
# fallback (see `latentedge <command> --help` for the exact name of
# each), so a run can be fully configured here and invoked with no
# flags at all. Uncomment and set whichever you want to stop passing
# on the command line:
# LATENTEDGE_FROM_BLOCK=
# LATENTEDGE_TO_BLOCK=
# LATENTEDGE_INGEST_OUT=data/swaps.parquet
# LATENTEDGE_CHUNK_SIZE=10
# LATENTEDGE_MAX_WORKERS=4
# LATENTEDGE_FLUSH_EVERY_N_CHUNKS=50
# LATENTEDGE_MAX_RETRIES=5
# LATENTEDGE_RETRY_BACKOFF_SECONDS=2.0
# LATENTEDGE_TRAIN_SWAPS=data/swaps.parquet
# LATENTEDGE_TRAIN_OUT=data/model.safetensors
# LATENTEDGE_TRAIN_EPOCHS=100
# LATENTEDGE_BACKTEST_SWAPS=data/swaps.parquet
# LATENTEDGE_BACKTEST_MODEL=data/model.safetensors

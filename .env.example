# .env.example — copy to .env and fill in. .env is git-ignored.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
LAYA_SERVER_URL=http://127.0.0.1:8787
LAYA_CONFIDENCE_THRESHOLD=0.85
EXECUTION_MODE=dry_run
SOLANA_KEYPAIR_PATH=
MAX_TRADE_SIZE=1000000
MAX_TRADES_PER_WINDOW=5
MAX_SLIPPAGE_BPS=50
MAX_DAILY_LOSS=5000000
KILL_SWITCH_PATH=./KILL_SWITCH
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
BASE_MINT=So11111111111111111111111111111111111111112
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
POLL_INTERVAL_MS=5000
TRADE_SIZE_PCT=0.1
STARTING_CAPITAL=1000000000
